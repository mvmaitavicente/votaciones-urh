# Configuración pública, incluida por Vite en el bundle al compilar.
VITE_INSFORGE_URL=https://feiztkc9.us-east.insforge.app
# Clave pública opaca oficial (anon_...), segura para el bundle del cliente.
# Obtener del dashboard. No usar claves administrativas ik_... ni JWT.
VITE_INSFORGE_ANON_KEY=

# RBAC_DEMO: solo desarrollo local, deshabilitado por defecto y siempre en producción.
VITE_RBAC_DEMO_ENABLED=false
VITE_RBAC_DEMO_URL=http://127.0.0.1:8787/functions/verificar-acceso

# Producción: la autorización usa el conector y sus bindings generados por pa.
# No hay VITE_ACCESS_TOKEN, secreto OAuth ni key administrativa de autorización.

# Etapa funcional GUID (solo pruebas); 'entra' conserva la implementación JWT/conector.
VITE_ACCESS_MODE=functional
VITE_FUNCTIONS_BASE_URL=https://feiztkc9.function2.insforge.app
