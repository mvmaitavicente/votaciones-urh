# SOLO SERVIDOR: copiar a .env.auth.local. Nunca VITE_* para credenciales.
ENTRA_TENANT_ID=7542cdab-2ecf-4371-956f-41795bcb56f7
ENTRA_AUDIENCES_V1=f1eb7fb0-a90c-4efb-9a50-f1ddb2c719da,api://f1eb7fb0-a90c-4efb-9a50-f1ddb2c719da
ENTRA_AUDIENCE_V2=f1eb7fb0-a90c-4efb-9a50-f1ddb2c719da
ENTRA_ALLOWED_CLIENT_IDS=f1eb7fb0-a90c-4efb-9a50-f1ddb2c719da
# CORS solo para fetch de navegador. El conector servidor-servidor no necesita Origin.
ACCESS_ALLOWED_ORIGINS=https://apps.powerapps.com,https://make.powerapps.com,https://make.powerautomate.com,http://localhost:5173,http://localhost:5174
INSFORGE_BASE_URL=https://feiztkc9.us-east.insforge.app
RBAC_SERVER_API_KEY=
# En el runtime alojado, si RBAC_SERVER_API_KEY falta, se reutiliza el secreto protegido API_KEY.

# Diagnóstico temporal de claims: desactivado por defecto, solo ACCESS_ENVIRONMENT=test.
ACCESS_ENVIRONMENT=production
AUTH_DIAGNOSTICS_ENABLED=false
# ISO UTC, máximo dos horas desde el arranque del handler; luego se desactiva automáticamente.
AUTH_DIAGNOSTICS_EXPIRES_AT=
