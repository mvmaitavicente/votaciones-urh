# SOLO SERVIDOR LOCAL. Copiar a .env.rbac.local (ignorado por Git).
RBAC_DEMO_ENABLED=false
RBAC_DEMO_ENVIRONMENT=controlled-test
RBAC_DEMO_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# fixtures usa únicamente las siete cuentas ficticias de scripts/rbac-demo-fixtures.mjs.
# insforge consulta las tablas reales y requiere permisos del servidor (no concedidos).
RBAC_DEMO_DATA_SOURCE=fixtures
# Opcional: aplicar un escenario ficticio a cada identidad de prueba autorizada.
# NO_REGISTRADO | INACTIVO | SIN_ROLES | ADMINISTRADOR | ELECTOR | AMBOS | ERROR
RBAC_DEMO_FIXTURE_SCENARIO=
# En modo real: JSON con máximo 20 cuentas sintéticas/controladas, no electores reales.
RBAC_DEMO_ALLOWED_IDENTITIES=
INSFORGE_BASE_URL=https://feiztkc9.us-east.insforge.app
# Solo en secretos de la función o este archivo local del servidor. Nunca VITE_*.
RBAC_SERVER_API_KEY=
